# Environment
NODE_ENV=development
PORT=5000

# Database (MySQL Only - per SRS §2.2 / recruitment-platform-dev)
DATABASE_URL="mysql://root:password@localhost:3306/recruitment_ats_db"

# JWT Authentication
JWT_SECRET="super-secret-jwt-key-change-this-in-production-min-32-chars"
JWT_EXPIRES_IN="7d"

# CORS
CORS_ORIGIN="http://localhost:5173"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Super Admin Initial Seed
ADMIN_INITIAL_EMAIL="admin@atsplatform.local"
ADMIN_INITIAL_PASSWORD="AdminSecurePassword123!"

# OAuth2 (Stage 1 / Epic 1)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:5000/api/v1/auth/google/callback"

LINKEDIN_CLIENT_ID="your-linkedin-client-id"
LINKEDIN_CLIENT_SECRET="your-linkedin-client-secret"
LINKEDIN_CALLBACK_URL="http://localhost:5000/api/v1/auth/linkedin/callback"

# SMTP / Mail Settings (Epic 4 / Notifications)
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=2525
SMTP_USER="smtp-username"
SMTP_PASS="smtp-password"
EMAIL_FROM="no-reply@recruitment-platform.local"
