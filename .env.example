# ==========================================
# Root Environment Template
# ==========================================
NODE_ENV=development

# Backend Settings
PORT=5000
DATABASE_URL="mysql://root:password@localhost:3306/recruitment_ats_db"
JWT_SECRET="super-secret-jwt-key-replace-in-production-min-32-chars"
JWT_EXPIRES_IN="7d"
CORS_ORIGIN="http://localhost:5173"
FRONTEND_URL="http://localhost:5173"

# Frontend Settings
VITE_API_BASE_URL="http://localhost:5000/api"

# Super Admin Seed Account
ADMIN_INITIAL_EMAIL="admin@atsplatform.local"
ADMIN_INITIAL_PASSWORD="AdminSecurePassword123!"

# SMTP / Email Notification Settings (Optional in dev; fallback logs directly to console)
# --- Option A: Gmail SMTP (Personal / Team Testing) ---
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER="your-email@gmail.com"
# SMTP_PASS="xxxx xxxx xxxx xxxx" # 16-character Google App Password (spaces auto-stripped)
# SMTP_FROM="RecruitATS Platform <your-email@gmail.com>"

# --- Option B: Mailtrap / Sandbox (Local Mail Testing) ---
SMTP_HOST="sandbox.smtp.mailtrap.io"
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_USER="smtp-username"
SMTP_PASS="smtp-password"
SMTP_FROM="RecruitATS Sandbox <noreply@atsplatform.local>"
